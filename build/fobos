cflags=-c -O2 -std=f2008 -ffree-line-length-none
lflags=-static-libgcc -static-libgfortran -static
build_dir=.
src=../src/
libs = ../lib/libaed2/obj/aed2_bio_utils.o
	   ../lib/libaed2/obj/aed2_carbon.o
	   ../lib/libaed2/obj/aed2_chlorophylla.o
