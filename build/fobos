	   ../lib/libaed2/obj/aed2_oxygen.o
	   ../lib/libaed2/obj/aed2_phosphorus.o
	   ../lib/libaed2/obj/aed2_phytoplankton.o
	   ../lib/libaed2/obj/aed2_sedflux.o
	   ../lib/libaed2/obj/aed2_silica.o
	   ../lib/libaed2/obj/aed2_totals.o
